# Lectoria reads plain environment variables (it does not load this file itself):
#   set -a; . ./.env; set +a; npm start
# Kavita and the voice engine are OPTIONAL. Leave a URL empty to switch that integration off on purpose;
# with both empty the Lectoria is a single-user reader (uploads, pasted text, voices running in the browser).

PORT=8104
HOST=127.0.0.1
LECTORIA_DATA=./data

# Kavita (library + shared reading progress + login). Empty = off, and the app signs you in as a single local user.
# Only expose a Kavita-less instance behind your own access control (reverse proxy auth, VPN or HOST=127.0.0.1).
LECTORIA_KAVITA_URL=http://127.0.0.1:5000

# Neural voice engine exposing /api/voice (BlogArtifex bridge). Empty = off: the voices run in the browser
# (Piper/Kokoro WASM) and the "Audios" (full audio files) view is hidden.
LECTORIA_VOICE_URL=http://127.0.0.1:8103
LECTORIA_VOICE_KEY_FILE=./data/voice-bridge.key

# Public Blogger blogs the reader may import from, comma-separated. Empty = no Blogs section.
LECTORIA_BLOGS=

# Optional folders
LECTORIA_CLOUD_DIR=
LECTORIA_EXPORT_DIR=
